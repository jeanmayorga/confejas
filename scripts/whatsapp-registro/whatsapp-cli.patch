@@ -0,0 +1,68 @@
+package whatsapp
+
+import (
+	waE2E "go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types/events"
+	"strings"
+)
+
+func messageContext(m *waE2E.Message) *waE2E.ContextInfo {
+	if m == nil {
+		return nil
+	}
+	switch {
+	case m.ExtendedTextMessage != nil:
+		return m.ExtendedTextMessage.GetContextInfo()
+	case m.ImageMessage != nil:
+		return m.ImageMessage.GetContextInfo()
+	case m.VideoMessage != nil:
+		return m.VideoMessage.GetContextInfo()
+	case m.DocumentMessage != nil:
+		return m.DocumentMessage.GetContextInfo()
+	case m.AudioMessage != nil:
+		return m.AudioMessage.GetContextInfo()
+	case m.StickerMessage != nil:
+		return m.StickerMessage.GetContextInfo()
+	}
+	return nil
+}
+func contextText(m *waE2E.Message) string {
+	if m == nil {
+		return ""
+	}
+	if s := extractTextContent(m); s != "" {
+		return s
+	}
+	if m.ImageMessage != nil {
+		return m.ImageMessage.GetCaption()
+	}
+	if m.VideoMessage != nil {
+		return m.VideoMessage.GetCaption()
+	}
+	if m.DocumentMessage != nil {
+		return m.DocumentMessage.GetCaption()
+	}
+	return ""
+}
+func (c *Client) persistMessageContext(m *events.Message) {
+	ctx := messageContext(m.Message)
+	id, sender, text, media := "", "", "", ""
+	if ctx != nil && (ctx.GetRemoteJID() == "" || ctx.GetRemoteJID() == m.Info.Chat.String()) {
+		id, sender, text = ctx.GetStanzaID(), ctx.GetParticipant(), contextText(ctx.GetQuotedMessage())
+		if q := ctx.GetQuotedMessage(); q != nil {
+			media, _, _, _, _, _, _ = extractMediaInfo(q)
+		}
+	}
+	_, err := c.Store.Messages.Exec("INSERT OR REPLACE INTO message_context VALUES (?,?,?,?,?,?,?)", m.Info.ID, m.Info.Chat.String(), m.Info.Sender.String(), id, sender, text, media)
+	if err != nil {
+		c.Logger.Warn("failed to store message context", "err", err)
+	}
+}
+func mentionReply(text string, ctx *waE2E.ContextInfo, enabled bool) string {
+	if !enabled || ctx == nil || ctx.GetParticipant() == "" {
+		return text
+	}
+	jid := ctx.GetParticipant()
+	ctx.MentionedJID = []string{jid}
+	return "@" + strings.Split(jid, "@")[0] + " " + text
+}
