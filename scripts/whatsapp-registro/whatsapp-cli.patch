+// connectionHealth allows a short reconnect/login grace period, but never waits forever.
+type connectionHealth struct{ unhealthySince time.Time }
+
+func (h *connectionHealth) expired(now time.Time, healthy bool) bool {
+	if healthy {
+		h.unhealthySince = time.Time{}
+		return false
+	}
+	if h.unhealthySince.IsZero() {
+		h.unhealthySince = now
+	}
+	return now.Sub(h.unhealthySince) >= 30*time.Second
+}
+func followConnection(ctx context.Context, connected, loggedIn func() bool) error {
+	ticker := time.NewTicker(5 * time.Second)
+	defer ticker.Stop()
+	health := connectionHealth{}
+	for {
+		select {
+		case <-ctx.Done():
+			return nil
+		case now := <-ticker.C:
+			if health.expired(now, connected() && loggedIn()) {
+				return fmt.Errorf("WhatsApp disconnected or unauthenticated for 30 seconds; restarting receiver")
+			}
+		}
+	}
+}
