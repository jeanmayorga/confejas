--- /dev/null
+++ b/internal/cli/sync_health_test.go
@@ -0,0 +1,31 @@
+package cli
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestConnectionHealthRecovery(t *testing.T) {
+	now := time.Now()
+	h := connectionHealth{}
+	if h.expired(now, false) || h.expired(now.Add(29*time.Second), false) {
+		t.Fatal("reconnect grace missing")
+	}
+	if !h.expired(now.Add(30*time.Second), false) {
+		t.Fatal("stalled receiver never exits")
+	}
+	if h.expired(now.Add(31*time.Second), true) {
+		t.Fatal("healthy receiver stopped")
+	}
+	if h.expired(now.Add(32*time.Second), false) {
+		t.Fatal("grace was not reset")
+	}
+}
+func TestFollowStopsImmediatelyOnCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := followConnection(ctx, func() bool { return false }, func() bool { return false }); err != nil {
+		t.Fatal(err)
+	}
+}
