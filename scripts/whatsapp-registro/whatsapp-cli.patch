diff --git a/internal/whatsapp/live_sync_test.go b/internal/whatsapp/live_sync_test.go
new file mode 100644
index 0000000..a691798
--- /dev/null
+++ b/internal/whatsapp/live_sync_test.go
@@ -0,0 +1,26 @@
+package whatsapp
+
+import (
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"testing"
+)
+
+func TestLiveOnlySkipsHistoryAndNameBackfill(t *testing.T) {
+	c := &Client{LiveOnly: true}
+	c.handleHistorySync(&events.HistorySync{})
+	c.backfillChatNames() // No database/network is needed in live-only mode.
+}
+func TestLiveMessagesFromOtherGroupsAreDiscarded(t *testing.T) {
+	c := &Client{SyncChat: "allowed@g.us"}
+	m := &events.Message{}
+	m.Info.Chat = types.JID{User: "other", Server: "g.us"}
+	c.handleMessage(m) // A non-allowed message must return before touching storage.
+}
+func TestPDFMimeType(t *testing.T) {
+	media, mime := classify("invitation.pdf")
+	if media != whatsmeow.MediaDocument || mime != "application/pdf" {
+		t.Fatalf("unexpected classification: %s %s", media, mime)
+	}
+}
