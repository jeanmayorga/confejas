@@ -0,0 +1,60 @@
+package whatsapp
+
+import (
+	"github.com/eddmann/whatsapp-cli/internal/store"
+	waE2E "go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"log/slog"
+	"path/filepath"
+	"testing"
+)
+
+func TestQuoteAndMention(t *testing.T) {
+	ctx := &waE2E.ContextInfo{Participant: protoString("593123@s.whatsapp.net"), StanzaID: protoString("original")}
+	m := &waE2E.Message{ExtendedTextMessage: &waE2E.ExtendedTextMessage{ContextInfo: ctx}}
+	if messageContext(m).GetStanzaID() != "original" {
+		t.Fatal("quote missing")
+	}
+	if got := mentionReply("Listo", ctx, true); got != "@593123 Listo" || len(ctx.MentionedJID) != 1 || ctx.MentionedJID[0] != "593123@s.whatsapp.net" {
+		t.Fatal("native mention missing", got)
+	}
+	if mentionReply("Listo", nil, true) != "Listo" {
+		t.Fatal("nil context")
+	}
+	if mentionReply("Listo", ctx, false) != "Listo" {
+		t.Fatal("unrequested mention")
+	}
+	image := &waE2E.Message{ImageMessage: &waE2E.ImageMessage{Caption: protoString("Nombre citado"), ContextInfo: ctx}}
+	if contextText(image) != "Nombre citado" || messageContext(image) != ctx {
+		t.Fatal("caption missing")
+	}
+}
+
+func TestPersistQuotesRestrictedToSourceChat(t *testing.T) {
+	db, err := store.Open(filepath.Join(t.TempDir(), "messages.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	c := &Client{Store: db, Logger: slog.Default()}
+	ctx := &waE2E.ContextInfo{StanzaID: protoString("old"), Participant: protoString("123@lid"), QuotedMessage: &waE2E.Message{Conversation: protoString("quoted body")}}
+	m := &events.Message{Message: &waE2E.Message{ExtendedTextMessage: &waE2E.ExtendedTextMessage{ContextInfo: ctx}}}
+	m.Info.ID = "new"
+	m.Info.Chat = types.JID{User: "group", Server: "g.us"}
+	m.Info.Sender = types.JID{User: "sender", Server: "lid"}
+	c.persistMessageContext(m)
+	var body, sender string
+	if err := db.Messages.QueryRow("SELECT quoted_text,sender_jid FROM message_context WHERE id='new'").Scan(&body, &sender); err != nil {
+		t.Fatal(err)
+	}
+	if body != "quoted body" || sender != "sender@lid" {
+		t.Fatal("lost context", body, sender)
+	}
+	ctx.RemoteJID = protoString("other@g.us")
+	c.persistMessageContext(m)
+	db.Messages.QueryRow("SELECT quoted_text FROM message_context WHERE id='new'").Scan(&body)
+	if body != "" {
+		t.Fatal("cross-chat quote leaked")
+	}
+}
